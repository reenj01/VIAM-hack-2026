# Do not put real credentials in this file.
# When you add Viam connectivity later, copy this file to .env and fill in values locally.
VIAM_MACHINE_ADDRESS=""
VIAM_API_KEY=""
VIAM_API_KEY_ID=""
VIAM_CAMERA_NAME="cam"
VIAM_DETECTOR_NAME="yolo-detector"
VIAM_ARM_NAME="arm"
# Test with -10 or 10 first. Change to -90 or 90 only after confirming that
# the sign is clockwise for your xArm when viewed from your chosen direction.
VIAM_CALIBRATION_JOINT_4_DELTA_DEG="-10"
VIAM_CALIBRATION_MOVE_SETTLE_SECONDS="1"
VIAM_GRIPPER_NAME="gripper"
VIAM_SEGMENTER_NAME="objects-3d"
VIAM_MOTION_NAME="builtin"
VIAM_TARGET_LABEL="cup"
# Validate these with `python pick_cup.py --stage hover` before grabbing.
VIAM_APPROACH_MM="-100"
VIAM_GRIPPER_CENTER_OFFSET_MM="-60"
VIAM_LIFT_MM="150"
# Joint angles are degrees. Test `--stage hover` after changing any value.
VIAM_OBSERVE_JOINTS="294.952,-60.135,-19.090,0.009,79.179,165.257"
# Resources for tutorial_phase5_pick.py. Save each corresponding Viam switch
# before using --stage full.
VIAM_HOME_POSE_NAME="pose-home"
VIAM_OBSERVE_POSE_NAME="pose-observe"
VIAM_TRAVEL_POSE_NAME="pose-travel"
VIAM_PLACE_POSE_NAME="pose-place"
VIAM_DEFAULT_STANDOFF_POSE_NAME="pose-observe"
VIAM_TUTORIAL_TARGET_LABEL="rectangle-red"
